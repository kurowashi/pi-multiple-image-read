{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	// lefthook runs from git hooks, which knip only recognizes when hooks are installed.
	"ignoreDependencies": ["lefthook"],
	// Scripts are run by hand (node scripts/...), so knip needs them as entries.
	"entry": ["src/index.ts", "test/**/*.test.ts", "scripts/*.ts"]
}
